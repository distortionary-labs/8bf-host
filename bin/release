#!/usr/bin/env bash
# Releases 8bf-host.
#
#   bin/release 0.2.0   set the version, date the changelog, check, commit,
#                       tag v0.2.0 and push
#   bin/release         the same for the version already in Cargo.toml
#
# The version's changelog section is the "## Unreleased" one, renamed to
# "## <version> - <today>"; if a dated section for the version already
# exists, it is used as is.
#
# Pushing the tag is the release: CI runs the full test suite, builds the
# Linux, Windows and macOS binaries, creates the GitHub release with them
# and the changelog section as notes, and publishes to crates.io when the
# CARGO_REGISTRY_TOKEN secret is set. Nothing is built here.
set -euo pipefail

cd "$(dirname "$0")/.."

current=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)
version=${1:-$current}
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
  echo "error: '$version' is not a semver version" >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "error: the working tree has uncommitted changes" >&2
  exit 1
fi
branch=$(git rev-parse --abbrev-ref HEAD)
if [[ "$branch" != main ]]; then
  echo "error: releases are made from main, not $branch" >&2
  exit 1
fi
git fetch -q origin main --tags
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]]; then
  echo "error: main and origin/main differ; pull or push first" >&2
  exit 1
fi
if git rev-parse -q --verify "refs/tags/v$version" >/dev/null; then
  echo "error: tag v$version already exists" >&2
  exit 1
fi

# Undo the version and changelog edits if anything below fails.
released=false
trap '$released || git checkout -q -- Cargo.toml Cargo.lock CHANGELOG.md' EXIT

if [[ "$version" != "$current" ]]; then
  sed -i "0,/^version = \"$current\"/s//version = \"$version\"/" Cargo.toml
  cargo update --workspace --offline -q
fi

if ! grep -q "^## $version - " CHANGELOG.md; then
  if ! grep -q '^## Unreleased$' CHANGELOG.md; then
    echo "error: CHANGELOG.md has neither '## $version - <date>' nor '## Unreleased'" >&2
    exit 1
  fi
  sed -i "0,/^## Unreleased$/s//## Unreleased\n\n## $version - $(date +%F)/" CHANGELOG.md
fi

cargo fmt --all -- --check
cargo clippy --all-targets -- -D warnings
cargo test
cargo test --features pack4
cargo publish --dry-run --allow-dirty -q

if [[ -n "$(git status --porcelain)" ]]; then
  git commit -q -am "Release $version"
fi
released=true
git tag -a "v$version" -m "8bf-host $version"
git push --atomic origin HEAD:main "v$version"

echo
echo "Pushed v$version. CI builds and publishes the release:"
echo "  gh run watch \$(gh run list -L 1 --branch v$version --json databaseId -q '.[0].databaseId')"
